---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WriteupsGallery from '../components/WriteupsGallery.astro';
import Projects from '../components/Projects.astro';
import Certs from '../components/Certs.astro';
import Profiles from '../components/Profiles.astro';
import LinkedInFeed from '../components/LinkedInFeed.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { certs } from '../data/site';
import profiles from '../data/profiles.json';

const writeups = (await getCollection('writeups')).filter((w) => !w.data.draft);
const projects = await getCollection('projects');

// "rooms completed" = HTB machines rooted + TryHackMe rooms + Proving Grounds writeups.
// HTB/THM come from profiles.json (scripts/scrape-profiles.mjs) — refreshed daily by
// .github/workflows/refresh-stats.yml, which also rebuilds+redeploys every run, so this
// stays current even on days the scrape itself doesn't change. PG has no public stats API,
// so its count is the number of published PG writeups — this recomputes on every build,
// which the same daily workflow triggers, so it's checked daily like the other two.
const pgWriteups = writeups.filter((w) => w.data.platform === 'Proving Grounds').length;
const roomsCompleted = (profiles.hackthebox?.systemOwns ?? 0) + (profiles.tryhackme?.rooms ?? 0) + pgWriteups;
---
<BaseLayout>
  <Nav />
  <Hero machines={roomsCompleted} writeups={writeups.length} certs={certs.length} />
  <Profiles />
  <WriteupsGallery writeups={writeups} limit={6} archiveHref="/writeups" tick="02." />
  <Projects projects={projects} />
  <Certs />
  <LinkedInFeed />
  <About />
  <Footer />
</BaseLayout>
