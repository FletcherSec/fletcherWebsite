---
import { profile, socials } from '../data/site';

interface Props {
  machines: number;
  writeups: number;
  certs: number;
}
const { machines, writeups, certs } = Astro.props;
---
<header class="hero container" id="top">
  <div class="hero-prompt">┌─[ <span class="accent">visitor</span>@fletcher ]─[ ~ ]</div>
  <div class="hero-prompt">└─$ whoami</div>

  <h1 class="hero-handle">fletcher<span class="hero-caret">&nbsp;</span></h1>
  <p class="hero-tag">{profile.role} · {profile.tagline}</p>

  <p class="hero-typed">&gt; <span id="typed"></span><span class="hero-caret">&nbsp;</span></p>

  <div class="hero-cta">
    <a class="btn btn-primary" href="/writeups">▸ browse writeups</a>
    <a class="btn" href={socials.github}>github</a>
    <a class="btn" href="#about">contact</a>
  </div>

  <div class="stats">
    <div class="stat"><div class="n">{machines}</div><div class="l">rooms completed</div></div>
    <div class="stat"><div class="n">{writeups}</div><div class="l">writeups</div></div>
    <div class="stat"><div class="n">{certs}</div><div class="l">certifications</div></div>
  </div>
</header>

<script>
  const phrases = [
    'rooting boxes on HTB & Proving Grounds.',
    'turning shells into writeups.',
    'eJPT · Security+ · AWS CCP.',
    'breaking things, then documenting how.',
  ];
  const el = document.getElementById('typed');
  let p = 0, c = 0, deleting = false;
  function tick() {
    if (!el) return;
    const word = phrases[p];
    el.textContent = word.slice(0, c);
    if (!deleting && c < word.length) { c++; }
    else if (!deleting && c === word.length) { deleting = true; setTimeout(tick, 1600); return; }
    else if (deleting && c > 0) { c--; }
    else { deleting = false; p = (p + 1) % phrases.length; }
    setTimeout(tick, deleting ? 35 : 70);
  }
  tick();
</script>
