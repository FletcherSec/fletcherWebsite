---
import profiles from '../data/profiles.json';
import { icons } from '../data/icons';

// Stats are scraped from the live THM/HTB profiles by scripts/scrape-profiles.mjs
// (Playwright captures each SPA's own JSON API). Re-run that to refresh numbers.
// Avatar + rank icon are downloaded to /public/profiles by the same script.
const thm = profiles.tryhackme;
const htb = profiles.hackthebox;

const fmt = (n: number | undefined) =>
  typeof n === 'number' ? n.toLocaleString('en-US') : '—';

const thmStats = thm
  ? [
      { l: 'rank', v: thm.rank ?? '—' },
      { l: 'points', v: fmt(thm.points) },
      { l: 'rooms', v: fmt(thm.rooms) },
      { l: 'badges', v: fmt(thm.badges) },
    ]
  : [];

const htbStats = htb
  ? [
      { l: 'user owns', v: fmt(htb.userOwns) },
      { l: 'rooted', v: fmt(htb.systemOwns) },
      { l: 'global', v: htb.globalRanking ?? '—' },
      {
        l: htb.nextRank ? `→ ${htb.nextRank.toLowerCase()}` : 'rank progress',
        v: typeof htb.rankProgress === 'number' ? `${Math.round(htb.rankProgress)}%` : '—',
      },
    ]
  : [];
---
<section id="stats" class="profiles">
  <div class="container">
    <div class="section-head">
      <span class="tick">01.</span>
      <h2>profiles</h2>
      <span class="section-sub">/ live stats pulled from TryHackMe &amp; Hack The Box</span>
    </div>

    <div class="prof-grid">
      {htb && (
        <a class="prof-card" href={htb.url} target="_blank" rel="noopener">
          <div class="prof-head">
            <span class="prof-ico" set:html={icons.hackthebox} />
            <div class="prof-id">
              <div class="prof-name">Hack The Box</div>
              <div class="prof-handle">@{htb.handle}</div>
            </div>
            {htb.classicRank && <span class="prof-tier">{htb.classicRank}</span>}
          </div>
          <div class="prof-stats">
            {htbStats.map((s) => (
              <div class="prof-stat"><div class="pv">{s.v}</div><div class="pl">{s.l}</div></div>
            ))}
          </div>
        </a>
      )}

      {thm && (
        <a class="prof-card" href={thm.url} target="_blank" rel="noopener">
          <div class="prof-head">
            {thm.avatar
              ? <img class="prof-avatar" src={thm.avatar} width="40" height="40" alt={`TryHackMe avatar for ${thm.handle}`} loading="lazy" />
              : <span class="prof-ico" set:html={icons.tryhackme} />}
            <div class="prof-id">
              <div class="prof-name">TryHackMe</div>
              <div class="prof-handle">@{thm.handle}</div>
            </div>
            {thm.topPercent && <span class="prof-tier">{thm.topPercent}</span>}
          </div>
          <div class="prof-stats">
            {thmStats.map((s) => (
              <div class="prof-stat"><div class="pv">{s.v}</div><div class="pl">{s.l}</div></div>
            ))}
          </div>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .prof-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.1rem; }
  .prof-card {
    display: flex; flex-direction: column; gap: 1rem;
    padding: 1.3rem; border-radius: var(--radius);
    background: var(--bg-card); border: 1px solid var(--border);
    color: inherit; transition: transform var(--speed), border-color var(--speed), box-shadow var(--speed);
  }
  .prof-card:hover {
    text-decoration: none; transform: translateY(-3px);
    border-color: var(--accent); box-shadow: var(--glow);
  }
  .prof-head { display: flex; align-items: center; gap: 0.8rem; }
  .prof-ico { color: var(--accent); flex: none; }
  .prof-ico :global(svg) { width: 30px; height: 30px; display: block; }
  .prof-avatar {
    flex: none; width: 40px; height: 40px; border-radius: 50%;
    object-fit: cover; border: 1px solid var(--border); background: var(--bg-elev);
  }
  .prof-id { min-width: 0; margin-right: auto; }
  .prof-name { font-family: var(--font-head); font-weight: 700; font-size: 1.05rem; color: var(--fg); }
  .prof-handle { font-family: var(--font-mono); font-size: 0.78rem; color: var(--fg-dim); }
  .prof-tier {
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700;
    color: var(--accent); border: 1px solid currentColor; border-radius: 999px; padding: 0.12rem 0.55rem;
  }

  .prof-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; }
  .prof-stat {
    text-align: center; padding: 0.6rem 0.3rem;
    background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius);
  }
  .pv { font-family: var(--font-head); font-size: 1.1rem; font-weight: 700; color: var(--accent); line-height: 1.2; }
  .pl { font-family: var(--font-mono); font-size: 0.64rem; color: var(--fg-dim); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 0.2rem; }

  @media (max-width: 420px) { .prof-stats { grid-template-columns: repeat(2, 1fr); } }
</style>
